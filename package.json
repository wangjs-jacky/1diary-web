{
  "name": "1diary-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:production-sync": "playwright test --config playwright.production.config.ts e2e/production-sync.spec.ts",
    "test:e2e:production-editor": "playwright test --config playwright.production.config.ts e2e/production-editor-visual.spec.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@internationalized/date": "3.12.3",
    "@supabase/supabase-js": "^2.112.4",
    "@tiptap/core": "3.30.3",
    "@tiptap/extension-placeholder": "3.30.3",
    "@tiptap/extension-task-item": "3.30.3",
    "@tiptap/extension-task-list": "3.30.3",
    "@tiptap/react": "3.30.3",
    "@tiptap/starter-kit": "3.30.3",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "1.34.0",
    "react": "^19.2.8",
    "react-aria-components": "1.20.0",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
